{
  "expo": {
    "name": "EZ Healthcare",
    "slug": "ezhealthcare",
    "version": "0.1.0",
    "scheme": "ezhealthcare",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#17618E"
        }
      ],
      "expo-splash-screen"
    ],
    "android": {
      "package": "com.anonymous.ezhealthcare",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    }
  }
}
